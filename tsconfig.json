{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // ESNext rather than a numbered library, for `Temporal`. It is the whole
    // substrate this package is built on and TypeScript ships its types here
    // and nowhere else yet; a numbered lib leaves `Temporal` undeclared.
    //
    // Note this is a claim about the runtime, and what backs it is a global
    // `Temporal` rather than any particular Node version. Node 26 has one
    // natively; below that a consumer assigns the polyfill before importing
    // Quando, which `engines` cannot express and docs/getting-started/ does.
    "lib": ["ESNext"],
    "types": ["node"],

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "removeComments": false
  },
  "include": ["src/**/*", "test/**/*", "bench/**/*", "scripts/**/*.ts"]
}
